<?xml version="1.0" encoding="UTF-8"?>
<lint>
    <!--
      Dependency freshness, ignored rather than baselined. These fire on upstream release
      schedules, not on the change under review, so under warningsAsErrors they would fail CI for
      reasons no reviewer can act on. A baseline is worse than an ignore here: the entries embed
      the upstream version in their message ("a newer version than 4.35.1 is available: 4.36.1"),
      so every release un-matches the entry and resurrects the finding.

      NewerVersionAvailable also has one permanently unfixable instance by design: the kotlin
      version in libs.versions.toml is pinned to AGP's built-in compiler, not the newest release.
    -->
    <issue id="NewerVersionAvailable" severity="ignore" />
    <issue id="GradleDependency" severity="ignore" />
    <issue id="AndroidGradlePluginVersion" severity="ignore" />
</lint>
