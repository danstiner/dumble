<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required to access local Mumble servers (e.g. for a LAN party). Specifically, targeting
         API 37+ gates RFC1918 destinations behind this permission. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- The fallback type when RECORD_AUDIO is not granted yet. Needs no runtime permission of its
         own, which is the whole point: the service starts during connect, before the microphone
         prompt has been shown. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".DumbleApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Dumble">

        <!-- windowSoftInputMode: unspecified defaults to adjustPan, which has the framework
             translate the whole window up to keep the focused field visible, on top of (not
             instead of) Compose's own imePadding()/WindowInsets.ime handling in ChatScreen —
             double-shifting content and pushing the top bar off-screen. adjustResize leaves
             Compose as the only thing moving content for the IME. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Dumble"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.VoiceService"
            android:exported="false"
            android:foregroundServiceType="microphone|mediaPlayback" />
    </application>

</manifest>
